Project {{PROJECT_NAME}} {
  database_type: '{{DATABASE_TYPE}}'
  Note: '{{PROJECT_NOTE}}'
}

Table {{PARENT_TABLE_NAME}} {
  {{PARENT_PRIMARY_KEY_COLUMN}} {{PARENT_PRIMARY_KEY_TYPE}} [pk, not null, note: '{{PARENT_PRIMARY_KEY_NOTE}}']
  {{PARENT_UNIQUE_COLUMN}} {{PARENT_UNIQUE_COLUMN_TYPE}} [not null, note: '{{PARENT_UNIQUE_COLUMN_NOTE}}']
  {{PARENT_TIMESTAMP_COLUMN}} {{PARENT_TIMESTAMP_TYPE}} [not null, note: '{{PARENT_TIMESTAMP_NOTE}}']

  indexes {
    ({{PARENT_UNIQUE_COLUMN}}) [name: '{{PARENT_UNIQUE_INDEX_NAME}}', unique, note: '{{PARENT_UNIQUE_INDEX_NOTE}}']
  }

  Note: '{{PARENT_TABLE_NOTE}}'
}

Table {{CHILD_TABLE_NAME}} {
  {{CHILD_PRIMARY_KEY_COLUMN}} {{CHILD_PRIMARY_KEY_TYPE}} [pk, not null, note: '{{CHILD_PRIMARY_KEY_NOTE}}']
  {{CHILD_FOREIGN_KEY_COLUMN}} {{CHILD_FOREIGN_KEY_TYPE}} [not null, ref: > {{PARENT_TABLE_NAME}}.{{PARENT_PRIMARY_KEY_COLUMN}}, note: '{{CHILD_FOREIGN_KEY_NOTE}}']
  {{CHILD_PAYLOAD_COLUMN}} {{CHILD_PAYLOAD_TYPE}} [not null, note: '{{CHILD_PAYLOAD_NOTE}}']
  {{CHILD_SORT_COLUMN}} {{CHILD_SORT_TYPE}} [not null, note: '{{CHILD_SORT_NOTE}}']

  indexes {
    ({{CHILD_FOREIGN_KEY_COLUMN}}, {{CHILD_SORT_COLUMN}}) [name: '{{CHILD_ORDER_INDEX_NAME}}', unique, note: '{{CHILD_ORDER_INDEX_NOTE}}']
  }

  Note: '{{CHILD_TABLE_NOTE}}'
}
